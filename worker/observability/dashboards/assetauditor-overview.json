{
  "title": "AssetAuditor — overview",
  "uid": "assetauditor-overview",
  "description": "One dashboard for a single-user MVP (CLAUDE.md: no premature abstraction) covering worker availability, ETL job outcomes, LLM extraction/commentary health, and API traffic. All queries read from Grafana Cloud hosted Prometheus (grafanacloud-prom), fed by worker/observability/alloy-config.alloy (worker+litellm+vllm scrape) and app/obs/metrics.py (API remote_write).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["assetauditor", "aa-27"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Worker heartbeat age",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "expr": "time() - worker_heartbeat_timestamp", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 7200 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "ETL jobs queued",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [{ "expr": "etl_jobs_queued", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Retention sweeper last success",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "expr": "time() - retention_sweeper_last_success_timestamp", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 93600 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Price refresh last success",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "expr": "time() - price_refresh_last_success_timestamp", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "ETL job outcomes (rate by status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "sum by (status) (rate(etl_jobs_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "ETL job duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(etl_job_duration_seconds_bucket[15m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "LLM requests (rate by outcome, backend)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "sum by (outcome, backend) (rate(llm_requests_total[5m]))",
          "legendFormat": "{{outcome}} / {{backend}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "LLM tokens (rate by backend)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "sum by (backend) (rate(llm_tokens_total[5m]))",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "API requests (rate by route, status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "sum by (route, status) (rate(api_requests_total[5m]))",
          "legendFormat": "{{route}} [{{status}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "API latency (avg seconds by route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "sum by (route) (rate(api_request_duration_seconds_sum[5m])) / sum by (route) (rate(api_request_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
