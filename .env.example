# AssetAuditor — secret names only (Security-Model.md: ".env.example documents
# names only"). Real values live in Vercel's encrypted env store, GitHub Actions
# secrets, and the worker box's local .env (git-ignored) — never in this repo.
# Provisioning any of these is a manual step for the owner; no cloud credentials
# or network access exist in the agent sandbox that authored this file.

# --- Vercel serverless functions (api/index.py) ---------------------------
# RLS-scoped Postgres connection the API uses per-request (AA-6).
DATABASE_URL=
# Supabase project (JWKS lookup for JWT verification — AA-6).
SUPABASE_URL=
SUPABASE_JWT_AUD=authenticated
# Vercel Blob — the API relays validated bronze upload bytes here (AA-11);
# also used by the worker (AA-18) for silver/gold parquet writes.
BLOB_READ_WRITE_TOKEN=
# Signs the short-lived upload URL POST /uploads hands back, carrying
# (user, sha256, institution, period) to PUT /uploads/blob without a DB row
# existing yet (AA-11).
UPLOAD_TOKEN_SECRET=
# Supabase Auth Admin API (service_role) — DELETE /account's last purge step
# hard-deletes the auth.users identity itself (AA-10). Distinct from
# DATABASE_URL above: that connection is RLS-scoped per-request and cannot
# touch auth.users; this key calls Supabase's Admin API directly and must
# never reach the frontend build.
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend build (Vite — only VITE_-prefixed vars reach the browser) ---
# Public by design: anon key is safe client-side, RLS enforces isolation.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Worker (owner's GPU box, docker-compose — never set in Vercel) -------
# service_role connection: bypasses RLS by design (worker writes across the
# whole schema on the user's behalf). Must never be exposed to the frontend
# build or any Vercel serverless env var per Security-Model.md.
WORKER_DATABASE_URL=
# LiteLLM router (llm/litellm.config.yaml) — Groq-only fallback until the
# vLLM profile is promoted (AA-33).
GROQ_API_KEY=
# Password to our OWN router, not a vendor credential — invent one:
#   python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
# The worker presents it as LITELLM_API_KEY (wired in worker/docker-compose.yml).
# CI mints a per-run key when no repo secret is set; only GROQ_API_KEY is required there.
LITELLM_MASTER_KEY=
# Grafana Alloy remote_write target (Observability.md, wired in AA-27) — free tier.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_API_KEY=

# --- Internal HMAC routes (retention sweeper, price refresh — AA-19/AA-21) -
# Shared secret between the GitHub Actions cron callers and /internal/*.
INTERNAL_HMAC_SECRET=

# --- Product analytics (frontend — behaviour events only, no financial values) -
# Unset in dev/CI: frontend/src/lib/analytics.ts no-ops without it. Event
# schemas (statement_uploaded/parse_confirmed/dashboard_drilldown) live in
# frontend/src/lib/analyticsEvents.ts and are enforced by a CI gate — AA-28.
VITE_AMPLITUDE_API_KEY=

# --- Demo mode (POST /api/demo/seed — AA-32) -------------------------------
# The one Supabase auth.users id the seed-from-fixtures route will ever write
# to (app/routes/demo.py's `_require_demo_user`); unset means the route
# always 503s, so the blog demo simply doesn't offer the button rather than
# risking it writing to whichever account happens to call it. Provisioning
# the actual shared demo login is a manual owner step, not part of this repo.
DEMO_USER_ID=

# --- CI: migration-dry-run job (.github/workflows/ci.yml) -----------------
# Dedicated free-tier Supabase project used only as a throwaway CI "branch"
# DB — not the paid Branching add-on (ADR v1.1.0 zero-cost contract). GitHub
# Actions secrets, not a local .env; listed here so the full secret surface
# is documented in one place.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
